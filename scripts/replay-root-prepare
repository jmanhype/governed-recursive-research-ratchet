#!/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/bin/python3.9
"""Reviewed namespace preparation or separately approved one-shot runtime smoke."""
import fcntl
import hashlib
import json
import os
from pathlib import Path
import stat
import subprocess
import sys

INSTALL = Path('/Library/GRRR/replay-package')
INPUTS = Path('/Library/GRRR/replay-inputs')
SELF = Path('/Library/GRRR/bootstrap/replay-root-prepare')
REVIEW = INPUTS / 'review.json'
TARGET = Path('/Library/GRRR/independent-replay')
LOCK = Path('/Library/GRRR/validated-corpus/v2-launch.lock')
CODE = {
    'budget.py': '8fffe1390b4094c6519cc4d37e83774aa6eb5c9402b5e3f2a40f748d320de5ab',
    'ledger.py': '90dc7b0d33cdb2b7eab6854d0a2237939ba2b9f9c75cc06d89e595c0a9285514',
    'replay_smoke.py': 'da36fdba58fa651ba80b8977ae062be7778be33499ae73a675c13557fed4f1a6',
    'replay_runtime.py': 'f6c77cc8e3290ff0706134a1b107a320bf65d25a4fdf7a183dcc4b23d4fe665a',
    'common.py': '33edaf942a89f5eb0b1481e3ca5f430d7229e2b87758894cf29f95217e479a21',
    'corpus_execution.py': '9613c1874502f7204ab3546bb4a8d20230f2431bad20583cda4b39b7c1ad84f4',
    'execution.py': '7b8585798e59ab1aa4cb668b48e855c5fcd417f0e2433c54e4da63f98487a86d',
    'trusted_execution.py': 'bfa9dcff3de920c313646dcbeec9706394836ba5ff2a369da1b7d7aa0e4290e4',
    'trusted_install.py': 'b7bc2b7c169c3d9e3d24d159f076d22a6505febbb41d9e11a3d1d2fc3576e32e',
    'trusted_transport.py': '024d34efa5d8e7d482fcdf213e2b807ef013b7870f59fd23258cc9c2ded9419b',
    'validated_corpus.py': 'a62e2f219d696f895d69af4b7a13b32dd7222ed842b2089525f62e547d852476',
    'replay_prerequisites.py': '20efcaf9b07b6feac4c70f7758bab37ac743a5aaff863134e36c60d5623432ae',
}
POLICY = '355e6f7d9dd0a65817cdc1a6421fba6347f5075c40f4a456ed601e753f14a77a'
PYTHON = Path('/Library/Developer/CommandLineTools/Library/Frameworks/Python3.framework/Versions/3.9/bin/python3.9')


def check(condition: bool, reason: str) -> None:
    if not condition:
        raise RuntimeError(reason)


def sha(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def canonical(value: object) -> bytes:
    return json.dumps(value, sort_keys=True, separators=(',', ':'), ensure_ascii=True, allow_nan=False).encode()


def unique(pairs: list) -> dict:
    result = {}
    for key, value in pairs:
        check(key not in result, 'Duplicate record field')
        result[key] = value
    return result


def validate_location(path: Path) -> None:
    """No caller-selected install path, symlink resolution, or checkout root entry."""
    check(path == SELF and path.is_absolute() and '..' not in path.parts,
          'Unregistered root launcher path')


def protected(path: Path, directory: bool = False, readonly: bool = True) -> None:
    """Validate metadata/ACLs before opening; no chmod repair of unsafe inputs."""
    check(path.is_absolute() and '..' not in path.parts, 'Unsafe protected path')
    for member in reversed((path, *path.parents)):
        info = member.lstat()
        check(not stat.S_ISLNK(info.st_mode) and info.st_uid == 0 and info.st_gid == 0
              and info.st_mode & 0o022 == 0, 'Unsafe ancestor')
        result = subprocess.run(['/bin/ls', '-lde', str(member)], check=True,
                                capture_output=True, timeout=2,
                                env={'PATH': '/usr/bin:/bin', 'LC_ALL': 'C'}).stdout
        check(bool(result.split()) and b'+' not in result.split()[0]
              and len(result.splitlines()) == 1, 'ACL-bearing path')
    info = path.lstat()
    check(stat.S_ISDIR(info.st_mode) if directory else stat.S_ISREG(info.st_mode), 'Wrong asset type')
    if not directory:
        check(info.st_nlink == 1 and (not readonly or info.st_mode & 0o222 == 0), 'Mutable file')


def read(path: Path, expected: str = None) -> bytes:
    protected(path)
    with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK), 'rb') as stream:
        info = os.fstat(stream.fileno())
        check(stat.S_ISREG(info.st_mode) and info.st_size <= 1048576, 'Invalid bounded record')
        raw = stream.read(1048577)
    check(len(raw) <= 1048576 and (expected is None or sha(raw) == expected), 'Asset hash differs')
    return raw


def write(path: Path, raw: bytes, owner: int, mode: int) -> None:
    """Exclusive write: leave partial state on failure for recovery, never overwrite."""
    with path.open('xb') as stream:
        stream.write(raw)
        stream.flush()
        os.fsync(stream.fileno())
        os.fchown(stream.fileno(), owner, owner)
        os.fchmod(stream.fileno(), mode)


def verify_destination(root: Path, expected: dict) -> None:
    """Reopen every expected object; reject extras, links, ACLs, metadata/byte drift.

    Expected owners are explicit data, allowing real unprivileged filesystem
    tests without pretending to have performed UID-320/321 positive probes.
    Production builds this inventory locally, never from runner input.
    """
    def stable(info: os.stat_result) -> tuple:
        return (info.st_dev, info.st_ino, info.st_mode, info.st_uid, info.st_gid,
                info.st_nlink, info.st_size, info.st_mtime_ns, info.st_ctime_ns)

    actual = {'.': root, **{str(p.relative_to(root)): p for p in root.rglob('*')}}
    check(set(actual) == set(expected), 'Destination inventory differs')
    for name, path in actual.items():
        spec = expected[name]
        info = path.lstat()
        check(not stat.S_ISLNK(info.st_mode) and info.st_uid == spec['uid']
              and info.st_gid == spec['gid'] and stat.S_IMODE(info.st_mode) == spec['mode'],
              'Destination metadata differs')
        listing = subprocess.run(['/bin/ls', '-lde', str(path)], check=True, capture_output=True,
                                 timeout=2, env={'PATH': '/usr/bin:/bin', 'LC_ALL': 'C'}).stdout
        check(bool(listing.split()) and b'+' not in listing.split()[0]
              and len(listing.splitlines()) == 1, 'Destination ACL present')
        if spec['kind'] == 'directory':
            check(stat.S_ISDIR(info.st_mode), 'Destination directory type differs')
        else:
            check(spec['kind'] == 'file' and stat.S_ISREG(info.st_mode)
                  and info.st_nlink == 1 and info.st_size == len(spec['raw']), 'Destination file differs')
            with os.fdopen(os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK), 'rb') as stream:
                opened = os.fstat(stream.fileno())
                check(stable(opened) == stable(info), 'Destination changed while opening')
                check(stream.read(len(spec['raw']) + 1) == spec['raw'], 'Destination bytes differ')
                check(stable(os.fstat(stream.fileno())) == stable(opened), 'Destination changed while reading')
            check(stable(path.lstat()) == stable(info), 'Destination path changed during verification')


def main() -> int:
    check(os.getuid() == 0 and os.geteuid() == 0, 'Root required; no effects performed')
    check(sys.argv[1:] in (['--prepare'], ['--runtime-smoke']), 'Unregistered parent action')
    smoke = sys.argv[1:] == ['--runtime-smoke']
    check(sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode, 'Isolated root required')
    check(Path(sys.executable) == PYTHON, 'Direct reviewed runtime required')
    validate_location(Path(__file__).absolute())
    protected(SELF)
    protected(Path(sys.executable), readonly=False)
    review = json.loads(read(REVIEW), object_pairs_hook=unique)
    check(set(review) == {'version', 'decision', 'launcher_sha256', 'python_sha256',
                         'code', 'policy_sha256', 'review_reference', 'runtime_identity',
                         'runtime_prelaunch_verified', 'preexec_boundary',
                         'preexec_environment'} | ({'smoke'} if smoke else set()), 'Review schema differs')
    check(type(review['version']) is int and review['version'] == 1
          and review['decision'] == ('approved-replay-runtime-smoke' if smoke
                                     else 'approved-replay-prerequisite-installation')
          and review['launcher_sha256'] == sha(read(SELF))
          and review['python_sha256'] == sha(Path(sys.executable).read_bytes())
          and review['code'] == CODE and review['policy_sha256'] == POLICY
          and review['preexec_boundary'] == '/usr/bin/env -i'
          and review['preexec_environment'] == {'PATH': '/usr/bin:/bin', 'LC_ALL': 'C'}
          and isinstance(review['review_reference'], str)
          and len(review['review_reference']) == 64
          and all(c in '0123456789abcdef' for c in review['review_reference']), 'Independent review binding differs')
    protected(INSTALL, directory=True)
    check({p.name for p in INSTALL.iterdir()} == set(CODE), 'Import closure differs')
    code = {name: read(INSTALL / name, expected) for name, expected in CODE.items()}
    # Only independently reviewed root-owned exact imports may now enter sys.path.
    sys.path.insert(0, str(INSTALL))
    from replay_runtime import verify_runtime, IDENTITY, RUNTIME, STDLIB
    check(sys.path == [str(INSTALL), str(RUNTIME / 'lib/python39.zip'),
                       str(STDLIB), str(STDLIB / 'lib-dynload')], 'Runtime import path differs')
    check(review['runtime_identity'] == IDENTITY and review['runtime_prelaunch_verified'] is True,
          'Mandatory trusted-parent runtime prelaunch verification absent')
    verify_runtime(current=True)
    if smoke:
        from replay_smoke import launch
        return launch(sys.modules[__name__], review, code)
    from replay_prerequisites import protected_preflight, PREPARED_MODE
    protected(LOCK)
    with os.fdopen(os.open(LOCK, os.O_RDONLY | os.O_NOFOLLOW), 'rb') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        plan = protected_preflight(INPUTS / 'corpus', INPUTS / 'vm',
                                   INPUTS / 'source.tar', INPUTS / 'policy.json', lock.fileno())
        # All privileged mutation begins here, after complete locked preflight.
        os.umask(0o077)
        TARGET.mkdir(mode=0o711)
        TARGET.chmod(0o711)
        expected = {'.': {'kind': 'directory', 'uid': 0, 'gid': 0, 'mode': 0o711}}
        def emit(name: str, raw: bytes, owner: int, mode: int) -> None:
            expected[name] = {'kind': 'file', 'uid': owner, 'gid': owner, 'mode': mode, 'raw': raw}
            write(TARGET / name, raw, owner, mode)
        for name, owner, mode in (('private', 0, 0o700), ('code', 0, 0o755),
                                  ('evaluator', 320, 0o700), ('runner', 0, 0o755),
                                  ('runner/executor', 321, 0o700)):
            path = TARGET / name
            path.mkdir(mode=mode)
            os.chown(path, owner, owner)
            path.chmod(mode)
            expected[name] = {'kind': 'directory', 'uid': owner, 'gid': owner, 'mode': mode}
        emit('private/preflight.json', canonical(plan), 0, 0o400)
        emit('private/review.json', canonical(review), 0, 0o400)
        for name, raw in code.items():
            emit('code/' + name, raw, 0, 0o444)
        emit('evaluator/policy.json', read(INPUTS / 'policy.json', POLICY), 320, 0o400)
        manifest = json.loads(read(INPUTS / 'corpus/manifest.json'), object_pairs_hook=unique)
        truth = read(INPUTS / 'corpus/protected/truth.json', manifest['artifacts']['protected/truth.json'])
        emit('evaluator/expectations.json', truth, 320, 0o400)
        for name in ('budget', 'reservations', 'ledger'):
            # Non-dispatchable genesis, not corpus history or a ReplayReceipt.
            emit('evaluator/' + name + '.json',
                  canonical({'version': 1, 'state': 'uninitialized', 'dispatch_enabled': False}), 320, 0o600)
        emit('private/prepared.pending', canonical({'namespace': str(TARGET),
              'root_installation': 'prepared', 'replay_dispatch': 'not-run',
              'execution_authorized': False, 'verdict_engine': 'not-installed'}), 0, PREPARED_MODE)
        verify_destination(TARGET, expected)
        os.rename(TARGET / 'private/prepared.pending', TARGET / 'private/prepared.json')
        expected['private/prepared.json'] = expected.pop('private/prepared.pending')
        verify_destination(TARGET, expected)
    print(canonical({'namespace': str(TARGET), 'replay_dispatch': 'not-run',
                     'execution_authorized': False}).decode())
    return 0


def identity_entry() -> int:
    """Only actual service identities enter the fixed reviewed code closure."""
    roles = {'--smoke-runner': 321, '--smoke-evaluator': 320}
    check(len(sys.argv) == 2 and sys.argv[1] in roles, 'Unregistered identity role')
    check(os.getuid() == roles[sys.argv[1]] and os.geteuid() == roles[sys.argv[1]], 'Wrong service identity')
    check(os.getgid() == roles[sys.argv[1]] and os.getegid() == roles[sys.argv[1]]
          and set(os.getgroups()) <= {roles[sys.argv[1]]}, 'Wrong service group boundary')
    check(sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode
          and Path(sys.executable) == PYTHON, 'Isolated reviewed runtime required')
    validate_location(Path(__file__).absolute())
    protected(SELF)
    protected(INSTALL, directory=True)
    check({p.name for p in INSTALL.iterdir()} == set(CODE), 'Import closure differs')
    for name, hashed in CODE.items():
        read(INSTALL / name, hashed)
    sys.path.insert(0, str(INSTALL))
    from replay_smoke import runner, evaluator
    return runner() if sys.argv[1] == '--smoke-runner' else evaluator()


if __name__ == '__main__':
    try:
        raise SystemExit(identity_entry() if sys.argv[1:] in (['--smoke-runner'], ['--smoke-evaluator']) else main())
    except Exception as exc:
        # No raw protected contents or private traceback escapes.
        print(canonical({'replay_dispatch': 'not-run', 'execution_authorized': False,
                         'error': type(exc).__name__,
                         'recovery': 'preserve-any-partial-namespace-for-parent-review'}).decode())
        raise SystemExit(1)

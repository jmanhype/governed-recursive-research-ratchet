#!/usr/bin/env python3
"""Operator-facing capstone driver: prepare a plan, then request a run.

The CLI holds no evaluator authority. `run` exits non-zero with an
`Unavailable` record because no authenticated dispatcher is wired here; the
plan itself is always emitted so each gate's truth is inspectable.
"""
import argparse
import json
from pathlib import Path
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'research'))

from capstone_driver import prepare, run  # noqa: E402
from common import Failure  # noqa: E402


def _load(path: str) -> dict:
    return json.loads(Path(path).read_bytes())


def main(argv=None) -> int:
    parser = argparse.ArgumentParser(prog='capstone-driver', add_help=True)
    modes = parser.add_subparsers(dest='mode', required=True)
    prep = modes.add_parser('prepare', help='bind revisions and emit a per-gate plan')
    prep.add_argument('--request', required=True)
    run_mode = modes.add_parser('run', help='request execution with a prepared plan')
    run_mode.add_argument('--plan', required=True)
    run_mode.add_argument('--request', required=True)
    args = parser.parse_args(argv)
    try:
        if args.mode == 'prepare':
            plan = prepare(_load(args.request))
            sys.stdout.write(json.dumps(plan, sort_keys=True) + '\n')
            return 0
        record = run(_load(args.plan), _load(args.request))
        sys.stdout.write(json.dumps(record, sort_keys=True) + '\n')
        return 0
    except Failure as exc:
        sys.stderr.write(json.dumps(exc.record, sort_keys=True) + '\n')
        return 1


if __name__ == '__main__':
    raise SystemExit(main())

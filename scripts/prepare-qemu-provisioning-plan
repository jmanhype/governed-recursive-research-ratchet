#!/usr/bin/env python3
"""Emit a proposed QEMU-only plan; no installation or accounting mutation."""
import json
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'research'))
from common import canonical, digest, require


def main():
    require(os.getuid() != 0 and len(sys.argv) == 2, 'InvalidInput', 'Non-root STAGED_QEMU required')
    staging = Path(sys.argv[1]).resolve()
    subprocess.run([sys.executable, '-I', '-S', '-B', str(ROOT / 'scripts/verify-staged-qemu'),
                    str(staging)], check=True, capture_output=True, timeout=30)
    host = json.loads(subprocess.run([sys.executable, '-I', '-S', '-B',
        str(ROOT / 'scripts/review-trusted-host')], check=True, capture_output=True, timeout=30).stdout)
    files = []
    def add(source, destination, expected=None):
        raw = source.read_bytes()
        require(not source.is_symlink() and (expected is None or digest(raw) == expected),
                'IntegrityFailure', 'Plan input changed')
        files.append({'source': str(source), 'destination': destination,
                      'sha256': digest(raw), 'size': len(raw)})
    for name, expected in host['files'].items():
        add(ROOT / name, 'snapshots/provisioned/' + name, expected)
    add(ROOT / 'scripts/trusted-root-bootstrap', 'bootstrap/trusted-root-bootstrap',
        host['bootstrap_sha256'])
    for path in sorted(staging.rglob('*')):
        if path.is_file():
            add(path, 'qemu/' + str(path.relative_to(staging)))
    plan = {'version': 1, 'decision': 'approved-qemu-provisioning-only',
            'installer_sha256': digest((ROOT / 'scripts/provision-trusted-host').read_bytes()),
            'python_sha256': host['interpreter_sha256'], 'host_code': host['host_code'],
            'files': files, 'source_files': host['files'], 'qemu_manifest': 'qemu/installation.json'}
    print(canonical(plan).decode())


if __name__ == '__main__':
    main()

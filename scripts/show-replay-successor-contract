#!/usr/bin/env python3
"""Print the proposed GRRR replay-successor contract summary."""

import json
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "research"))

from replay_successor_contract import contract_summary  # noqa: E402


def main() -> int:
    if sys.argv[1:]:
        raise SystemExit("no arguments accepted")
    print(json.dumps(contract_summary(), indent=2, sort_keys=True,
                     ensure_ascii=True, allow_nan=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env python3
"""Same mandatory entrypoint for local/CI; never starts a substitute host candidate."""
from pathlib import Path
import subprocess
import sys
ROOT = Path(__file__).resolve().parents[1]
if sys.argv[1:] not in (['bounded-challenge'], ['offline-preflight'], ['trusted-observation']):
    print('Usage: ./scripts/test-story bounded-challenge|offline-preflight|trusted-observation', file=sys.stderr)
    raise SystemExit(2)
if sys.argv[1] == 'offline-preflight':
    import json
    try:
        binding = json.loads((ROOT / '.offline-inputs.json').read_bytes())
        if set(binding) != {'vm_directory', 'prepared_assets', 'license_review'}:
            raise ValueError('Offline input binding schema differs')
        result = subprocess.run([sys.executable, str(ROOT / 'scripts/offline-identity-integration'),
                                 binding['vm_directory'], binding['prepared_assets'], binding['license_review']],
                                cwd=ROOT, timeout=2100)
        raise SystemExit(result.returncode)
    except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
        print('FAIL: mandatory offline prerequisites unavailable: ' + str(exc), file=sys.stderr)
        raise SystemExit(1)
try:
    module = 'trusted_observation.py' if sys.argv[1] == 'trusted-observation' else 'bounded_challenge.py'
    result = subprocess.run([sys.executable, str(ROOT / 'tests/integration' / module)],
                            cwd=ROOT, timeout=600)
    raise SystemExit(result.returncode)
except subprocess.TimeoutExpired:
    print('FAIL: mandatory suite exceeded 600 seconds; no skipped success', file=sys.stderr)
    raise SystemExit(1)

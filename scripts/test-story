#!/usr/bin/env python3
"""Same mandatory entrypoint for local/CI; never starts a substitute host candidate."""
from pathlib import Path
import subprocess
import sys
ROOT = Path(__file__).resolve().parents[1]
if sys.argv[1:2] == ['milestone-e2e']:
    result = subprocess.run([sys.executable, '-I', '-S', '-B',
                             str(ROOT / 'tests/e2e/milestone.py'), *sys.argv[2:]],
                            cwd=ROOT, timeout=120)
    raise SystemExit(result.returncode)
if sys.argv[1:] not in (['bounded-challenge'], ['offline-preflight'], ['trusted-observation'],
                        ['validated-corpus'], ['durable-evidence'], ['safe-stop'], ['independent-replay']):
    print('Usage: ./scripts/test-story bounded-challenge|offline-preflight|trusted-observation|validated-corpus|durable-evidence|safe-stop|independent-replay|milestone-e2e [--json]', file=sys.stderr)
    raise SystemExit(2)
if sys.argv[1] == 'offline-preflight':
    import json
    try:
        binding = json.loads((ROOT / '.offline-inputs.json').read_bytes())
        if set(binding) != {'vm_directory', 'prepared_assets', 'license_review'}:
            raise ValueError('Offline input binding schema differs')
        result = subprocess.run([sys.executable, str(ROOT / 'scripts/offline-identity-integration'),
                                 binding['vm_directory'], binding['prepared_assets'], binding['license_review']],
                                cwd=ROOT, timeout=2100)
        raise SystemExit(result.returncode)
    except (OSError, ValueError, subprocess.TimeoutExpired) as exc:
        print('FAIL: mandatory offline prerequisites unavailable: ' + str(exc), file=sys.stderr)
        raise SystemExit(1)
try:
    if sys.argv[1] == 'durable-evidence':
        result = subprocess.run([sys.executable, '-I', '-S', '-B',
                                 str(ROOT / 'scripts/durable-identity-integration')], cwd=ROOT, timeout=360)
        raise SystemExit(result.returncode)
    if sys.argv[1] == 'safe-stop':
        result = subprocess.run([sys.executable, '-I', '-S', '-B',
                                 str(ROOT / 'scripts/safe-stop-identity-integration')], cwd=ROOT, timeout=180)
        raise SystemExit(result.returncode)
    if sys.argv[1] == 'trusted-observation':
        print('FAIL: trusted-observation requires approved isolated identity launcher; 10 required, 0 executed, 0 skipped; gate not-run', file=sys.stderr)
        raise SystemExit(1)
    module = {'bounded-challenge': 'bounded_challenge.py', 'trusted-observation': 'trusted_observation.py',
              'validated-corpus': 'validated_corpus.py', 'independent-replay': 'independent_replay.py'}[sys.argv[1]]
    result = subprocess.run([sys.executable, str(ROOT / 'tests/integration' / module)],
                            cwd=ROOT, timeout=21600 if sys.argv[1] == 'validated-corpus' else 600)
    raise SystemExit(result.returncode)
except subprocess.TimeoutExpired:
    print('FAIL: mandatory suite exceeded 600 seconds; no skipped success', file=sys.stderr)
    raise SystemExit(1)

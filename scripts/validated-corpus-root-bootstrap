#!/usr/bin/python3
"""Install independently, root-owned; NEVER execute the checkout as root."""
import hashlib
import json
import os
from pathlib import Path
import shutil
import stat
import subprocess
import sys
import tempfile


def check(condition, message):
    if not condition: raise RuntimeError(message)


def sha(raw): return hashlib.sha256(raw).hexdigest()


def canonical(value):
    return json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=True,allow_nan=False).encode()


def unique(pairs):
    result={}
    for key,value in pairs:
        check(key not in result,'duplicate key'); result[key]=value
    return result


def protected(path,directory=False,readonly=True):
    check(path.is_absolute() and '..' not in path.parts,'unsafe path')
    for member in reversed((path,*path.parents)):
        info=member.lstat(); check(not stat.S_ISLNK(info.st_mode) and info.st_uid==0 and info.st_gid==0 and info.st_mode&0o022==0,'unsafe ancestor')
        listing=subprocess.run(['/bin/ls','-lde',str(member)],check=True,capture_output=True,timeout=2,
                               env={'PATH':'/usr/bin:/bin','LC_ALL':'C'}).stdout
        check(b'+' not in listing.split(None,1)[0],'ACL-bearing ancestor')
    info=path.lstat(); check(stat.S_ISDIR(info.st_mode) if directory else stat.S_ISREG(info.st_mode),'wrong type')
    if not directory: check(info.st_nlink==1 and (not readonly or info.st_mode&0o222==0),'non-immutable file')


def read_json(path,trusted=False):
    if trusted: protected(path)
    with os.fdopen(os.open(path,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK),'rb') as stream:
        info=os.fstat(stream.fileno()); check(stat.S_ISREG(info.st_mode) and info.st_size<=1048576,'invalid JSON'); return json.loads(stream.read(1048577),object_pairs_hook=unique)


def main():
    check(os.getuid()==0 and sys.flags.isolated and sys.flags.no_site and sys.flags.dont_write_bytecode,'isolated root required')
    check(len(sys.argv)==8,__doc__)
    self_path=Path(__file__).absolute(); protected(self_path)
    check(self_path.parent==Path('/Library/GRRR/bootstrap'),'unregistered bootstrap location')
    interpreter=Path(sys.executable); protected(interpreter,readonly=False)
    source,binding_path,approval_path,license_path,qemu_path,vm,prepared=map(Path,sys.argv[1:])
    approval=read_json(approval_path,True); check(approval.get('decision')=='approved-trusted-execution','execution not authorized')
    check(approval.get('bootstrap_sha256')==sha(self_path.read_bytes()),'bootstrap pin differs')
    check(approval.get('python_sha256')==sha(interpreter.read_bytes()),'interpreter pin differs')
    binding=read_json(binding_path); files=binding['files']; corpus_files=binding['corpus_files']
    check(isinstance(files,dict) and 0<len(files)<=128,'invalid inventory')
    check(set(corpus_files)=={'corpus/manifest.json','corpus/protected/truth.json'},'invalid corpus asset inventory')
    check(sha(canonical(files))==approval['host_code'],'source inventory differs')
    check('scripts/validated-corpus-identity-integration' in files,'launcher absent')
    read_json(license_path,True); qemu=read_json(qemu_path,True)
    check(sha(canonical(qemu))==approval['qemu_installation'],'QEMU pin differs')
    corpus=Path('/Library/GRRR/validated-corpus/v2'); protected(corpus,directory=True)
    for member in ('input.iso','prepared-profile.json'):
        protected(corpus/member); check(sha((corpus/member).read_bytes())==approval[{'input.iso':'image','prepared-profile.json':'profile'}[member]],'corpus pin differs')
    protected(corpus/'preparation.json')
    snapshots=Path('/Library/GRRR/snapshots'); protected(snapshots,directory=True)
    check(shutil.disk_usage(snapshots).free>=15000000000,'space floor unavailable')
    os.umask(0o077); target=Path(tempfile.mkdtemp(prefix='corpus-approved-',dir=snapshots))
    for name,expected in files.items():
        relative=Path(name); check(not relative.is_absolute() and '..' not in relative.parts and str(relative)==name,'unsafe source member')
        with os.fdopen(os.open(source/relative,os.O_RDONLY|os.O_NOFOLLOW|os.O_NONBLOCK),'rb') as stream:
            info=os.fstat(stream.fileno()); check(stat.S_ISREG(info.st_mode) and info.st_size<=10485760,'unsafe source size')
            data=stream.read(10485761)
        check(sha(data)==expected,'source changed'); destination=target/relative; destination.parent.mkdir(parents=True,exist_ok=True,mode=0o755)
        with destination.open('xb') as stream: stream.write(data); stream.flush(); os.fsync(stream.fileno())
        destination.chmod(0o444)
    for name,expected in corpus_files.items():
        relative=Path(name); check(not relative.is_absolute() and '..' not in relative.parts,'unsafe corpus asset')
        data=(source/relative).read_bytes(); check(sha(data)==expected,'corpus asset changed')
        destination=target/relative; destination.parent.mkdir(parents=True,exist_ok=True,mode=0o755)
        with destination.open('xb') as stream: stream.write(data); stream.flush(); os.fsync(stream.fileno())
        destination.chmod(0o444)
    for directory in sorted((p for p in target.rglob('*') if p.is_dir()),reverse=True): directory.chmod(0o555)
    target.chmod(0o555)
    result=subprocess.run([str(interpreter),'-I','-S','-B',str(target/'scripts/validated-corpus-identity-integration'),
        '--bootstrap-run',str(vm.absolute()),str(prepared.absolute()),str(approval_path.absolute()),
        str(license_path.absolute()),str(qemu_path.absolute())],cwd=target,
        env={'PATH':'/usr/bin:/bin','HOME':'/var/empty'},timeout=21600)
    return result.returncode


if __name__=='__main__':
    try: raise SystemExit(main())
    except Exception as exc:
        print(json.dumps({'validated_corpus':'not-run','error':str(exc),'execution_authorized':False},sort_keys=True)); raise SystemExit(1)

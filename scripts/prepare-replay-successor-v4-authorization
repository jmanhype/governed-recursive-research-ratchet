#!/usr/bin/env python3
"""Emit the Stage S authorization preparation record to stdout."""

import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / "research"))

from replay_successor_authorization import emit_record


def main() -> int:
    record = emit_record(ROOT)
    json.dump(record, sys.stdout, indent=2, sort_keys=True, ensure_ascii=True)
    sys.stdout.write("\n")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env python3
"""Build trusted guest artifacts and read back detached media; NEVER boot a VM.

Usage: python3 scripts/prepare-trusted-observation SOURCE GO_ARCHIVE VM_ASSETS NEW_OUTPUT
Only trusted supervisor/helper sources are cross-compiled on host. Pinned vlt
source is inventoried and packaged, never built/executed here.
"""
import json
import os
from pathlib import Path
import shutil
import struct
import subprocess
import sys
import time

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'research'))
from common import canonical, digest, require
from offline import clone_asset, package_source, source_inventory, TOOLCHAIN_SHA256
from execution import ASSETS, QEMU

FLOOR = 15000000000
PROPOSAL = '1830a92ad2cbd91788051304ec8f6acaebf256b85065b2db2c07271b6906e3f6'


def space(path: Path, additional: int = 0) -> int:
    free = shutil.disk_usage(path).free
    require(free - additional >= FLOOR, 'BudgetExceeded', 'Preparation would cross 15 GB floor')
    return free


def capture(args: list[str], env: dict | None = None) -> bytes:
    """Fixed tool invocation only; never execute the generated guest ELF."""
    return subprocess.run(args, env=env, capture_output=True, check=True, timeout=240).stdout


def elf_identity(path: Path) -> dict:
    raw = path.read_bytes()
    require(len(raw) >= 64 and raw[:6] == b'\x7fELF\x02\x01' and struct.unpack_from('<H', raw, 18)[0] == 183,
            'IntegrityFailure', 'Expected little-endian ELF64 AArch64')
    offset = struct.unpack_from('<Q', raw, 32)[0]
    entry, count = struct.unpack_from('<HH', raw, 54)
    require(entry >= 56 and offset + entry * count <= len(raw), 'IntegrityFailure', 'Invalid ELF headers')
    require(all(struct.unpack_from('<I', raw, offset + i * entry)[0] != 3 for i in range(count)),
            'IntegrityFailure', 'Unexpected dynamic interpreter')
    return {'sha256': digest(raw), 'bytes': len(raw), 'machine': 'AArch64', 'interpreter': None}


def iso_readback(image: Path, expected: dict[str, str]) -> dict:
    """Verify primary ISO namespace and every byte without mounting or executing."""
    with image.open('rb') as stream:
        stream.seek(16 * 2048)
        primary = stream.read(2048)
        require(primary[:7] == b'\x01CD001\x01', 'IntegrityFailure', 'Missing primary ISO descriptor')
        root = primary[156:190]
        stream.seek(int.from_bytes(root[2:6], 'little') * 2048)
        directory = stream.read(int.from_bytes(root[10:14], 'little'))
        offset, found = 0, {}
        while offset < len(directory):
            size = directory[offset]
            if not size:
                offset = (offset // 2048 + 1) * 2048
                continue
            record = directory[offset:offset + size]
            require(len(record) >= 34, 'IntegrityFailure', 'Truncated ISO directory')
            raw_name = record[33:33 + record[32]]
            if raw_name not in (b'\x00', b'\x01'):
                name = raw_name.decode('ascii').split(';')[0].lower().rstrip('.')
                require(name in expected and name not in found and not record[25] & 2,
                        'IntegrityFailure', 'Unexpected/duplicate primary ISO entry')
                stream.seek(int.from_bytes(record[2:6], 'little') * 2048)
                data = stream.read(int.from_bytes(record[10:14], 'little'))
                require(digest(data) == expected[name], 'IntegrityFailure', 'Detached image byte mismatch')
                found[name] = {'sha256': digest(data), 'bytes': len(data), 'primary_name': raw_name.decode()}
            offset += size
    require(found.keys() == expected.keys(), 'IntegrityFailure', 'Incomplete detached image')
    return found


def prepare(source: Path, archive: Path, vm: Path, target: Path) -> dict:
    require(not target.exists(), 'InvalidInput', 'Use a fresh preparation directory')
    proposal_path = ROOT / 'docs/TRUSTED-OBSERVATION-PROFILE-PROPOSAL.json'
    require(digest(proposal_path.read_bytes()) == PROPOSAL, 'StaleBinding', 'Development proposal differs')
    # Reserve room for host cross-build cache plus detached image, not merely
    # current free space. No automatic cleanup or limit increase.
    initial_free = space(target.parent, 350000000)
    require(digest(archive.read_bytes()) == TOOLCHAIN_SHA256, 'IntegrityFailure', 'Go archive differs')
    proposal = json.loads(proposal_path.read_bytes())
    actual_assets = {}
    for name, expected_hash in ASSETS.items():
        path = vm / ('boot/' + name if name != 'alpine-virt-3.22.6-aarch64.iso' else name)
        require(path.is_file() and not path.is_symlink(), 'IntegrityFailure', 'Missing or linked shared VM asset')
        actual_assets[name] = digest(path.read_bytes())
        require(actual_assets[name] == expected_hash, 'IntegrityFailure', 'Shared VM asset changed')
    actual_assets['qemu'] = digest(Path(QEMU).read_bytes())
    require(actual_assets['qemu'] == proposal['qemu_sha256'], 'StaleBinding', 'Proposed QEMU changed')
    inventory = source_inventory(source)
    target.mkdir(mode=0o700)
    media = target / 'media'
    media.mkdir(mode=0o700)
    package_source(source, inventory['files'], media / 'vlt.tar')
    (media / 'source.sum').write_text(''.join(item['sha256'] + '  ' + name + '\n'
        for name, item in sorted(inventory['files'].items())))
    clone_asset(archive, media / 'go.tgz')
    shutil.copyfile(ROOT / 'research/trusted-guest.sh', media / 'guest.sh')
    compiler = Path('/opt/homebrew/bin/go').resolve(strict=True)
    compiler_hash = digest(compiler.read_bytes())
    # Homebrew stores the Go license at the formula prefix, above libexec.
    compiler_license = compiler.parents[2] / 'LICENSE'
    require(compiler_license.is_file(), 'GateBlocked', 'Host compiler license unavailable for review')
    compiler_version = capture([str(compiler), 'version']).decode().strip()
    require(compiler_version == 'go version go1.26.7 darwin/arm64',
            'StaleBinding', 'Host preparation compiler changed; review required')
    env = {'PATH': '/opt/homebrew/bin:/usr/bin:/bin', 'HOME': '/var/empty',
           'GOOS': 'linux', 'GOARCH': 'arm64', 'CGO_ENABLED': '0', 'GO111MODULE': 'off',
           'GOTOOLCHAIN': 'local', 'GOPROXY': 'off', 'GOSUMDB': 'off',
           'GOCACHE': str(target / 'build-cache'), 'GOMAXPROCS': '1'}
    sources = ROOT / 'research/trusted-supervisor'
    commands = []
    for output, names in [('supervis', ['supervisor_linux.go', 'protocol.go']),
                          ('helper', ['candidate_helper_linux.go'])]:
        args = [str(compiler), 'build', '-p=1', '-trimpath', '-buildvcs=false', '-ldflags=-buildid=',
                '-o', str(media / output), *(str(sources / name) for name in names)]
        commands.append(args)
        capture(args, env)
        space(target)
    expected = {p.name: digest(p.read_bytes()) for p in media.iterdir()}
    (media / 'input.sum').write_text(''.join(hashed + '  ' + name + '\n' for name, hashed in sorted(expected.items())))
    expected['input.sum'] = digest((media / 'input.sum').read_bytes())
    image = target / 'input.iso'
    space(target, sum(p.stat().st_size for p in media.iterdir()) + 10000000)
    capture(['/usr/bin/hdiutil', 'makehybrid', '-iso', '-joliet', '-default-volume-name', 'GRRR_TRUSTED',
             '-o', str(image), str(media)])
    readback = iso_readback(image, expected)
    final_free = space(target)
    binding = {'version': 1, 'kind': 'development-review-only',
               'proposal_sha256': PROPOSAL, 'authorization_source': 'Operator approval recorded in GRRR-gu87 nd notes',
               'execution_authorized': False}
    (target / 'development-binding.json').write_bytes(canonical(binding))
    profile = dict(proposal)
    profile.update(authorization='development-review-only', dispatch_enabled=False,
                   supervisor_sha256=elf_identity(media / 'supervis')['sha256'],
                   input_image_sha256=digest(image.read_bytes()),
                   candidate_helper_sha256=elf_identity(media / 'helper')['sha256'],
                   guest_script_sha256=expected['guest.sh'],
                   development_binding_sha256=digest(canonical(binding)),
                   blocked_reason='Separate execution approval and actual identity/guest proof required')
    (target / 'prepared-profile.json').write_bytes(canonical(profile))
    receipt = {'version': 1, 'kind': 'preparation-not-execution', 'vm_execution_performed': False,
               'candidate_execution_performed': False, 'initial_free_bytes': initial_free,
               'final_free_bytes': final_free, 'compiler': {'version': compiler_version, 'sha256': compiler_hash,
               'scope': 'Host trusted-source cross-compilation only; separate execution review includes this new provenance'},
               'compiler_license_sha256': digest(compiler_license.read_bytes()),
               'compiler_license_text': compiler_license.read_text(),
               'shared_assets': actual_assets,
               'commands': commands, 'source': inventory, 'toolchain_sha256': TOOLCHAIN_SHA256,
               'supervisor': elf_identity(media / 'supervis'), 'helper': elf_identity(media / 'helper'),
               'supervisor_source_hashes': {p.name: digest(p.read_bytes()) for p in sources.glob('*.go')},
               'image_sha256': profile['input_image_sha256'], 'image_bytes': image.stat().st_size,
               'profile_sha256': digest(canonical(profile)), 'development_binding_sha256': digest(canonical(binding)),
               'primary_iso_readback': readback, 'execution_approval': 'absent'}
    (target / 'preparation.json').write_bytes(canonical(receipt))
    return receipt


if __name__ == '__main__':
    require(len(sys.argv) == 5, 'InvalidInput', 'Usage: prepare-trusted-observation SOURCE GO_ARCHIVE VM_ASSETS NEW_OUTPUT')
    result = prepare(Path(sys.argv[1]).resolve(strict=True), Path(sys.argv[2]).resolve(strict=True),
                     Path(sys.argv[3]).resolve(strict=True), Path(sys.argv[4]).absolute())
    print(canonical({key: result[key] for key in ('image_sha256', 'profile_sha256', 'supervisor',
                                                'development_binding_sha256', 'final_free_bytes')}).decode())

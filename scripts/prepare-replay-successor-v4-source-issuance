#!/usr/bin/env python3
"""Print the exact repository-only v4 source issuance package."""

import json
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "research"))

from replay_successor_source_issuance import (  # noqa: E402
    build_source_bundle, validate_source_bundle,
)


def main() -> int:
    if sys.argv[1:]:
        raise SystemExit("no arguments accepted")
    value = build_source_bundle(ROOT)
    validate_source_bundle(value, ROOT)
    print(json.dumps(value, indent=2, sort_keys=True,
                     ensure_ascii=True, allow_nan=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env python3
"""Generate the GRRR-z3w9 Stage H response-readiness matrix."""

import json
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "research"))

from spendability_response import (  # noqa: E402
    build_response_readiness,
    validate_response_readiness,
)


def main() -> int:
    if sys.argv[1:]:
        raise SystemExit("no arguments accepted")
    record = build_response_readiness(ROOT)
    validate_response_readiness(record, ROOT)
    print(json.dumps(record, indent=2, sort_keys=True, ensure_ascii=True, allow_nan=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

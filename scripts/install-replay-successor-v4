#!/usr/bin/env python3
"""Refuse installation until exact protected v4 source is independently issued."""

import os
from pathlib import Path
import sys


INSTALL = Path("/Library/GRRR/bootstrap/install-replay-successor-v4")
PYTHON = Path(
    "/Library/Developer/CommandLineTools/Library/Frameworks/"
    "Python3.framework/Versions/3.9/bin/python3.9"
)


def main() -> int:
    if sys.argv[1:] != ["install", "PLAN", "REVIEW", "AUTHORIZATION", "SHA256"]:
        raise SystemExit(
            "install PLAN REVIEW AUTHORIZATION SHA256"
        )
    if (os.getuid() != 0 or os.geteuid() != 0
            or Path(__file__).resolve() != INSTALL
            or Path(sys.executable) != PYTHON
            or not sys.flags.isolated or not sys.flags.no_site
            or not sys.dont_write_bytecode):
        raise SystemExit("root-only isolated canonical v4 installer required")
    # Even a correctly staged copy must remain inert until Stage P's source,
    # plan, review, and operator authorization identities are separately issued.
    raise SystemExit("protected v4 installer source is not issued")


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env python3
"""Unprivileged parent prelaunch check; never elevate or run the root preparer."""
import os
from pathlib import Path
import sys

if os.getuid() == 0 or os.geteuid() == 0:
    raise SystemExit('Runtime prelaunch verification must run before elevation')
if sys.argv[1:]:
    raise SystemExit('No arguments accepted')
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / 'research'))
from replay_runtime import canonical, verify_runtime
try:
    print(canonical(verify_runtime()).decode())
except Exception as exc:
    print(canonical({'runtime': 'blocked', 'root_launch_authorized': False,
                     'error': type(exc).__name__}).decode())
    raise SystemExit(1)

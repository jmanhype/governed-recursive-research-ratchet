#!/usr/bin/env python3
"""Generate the GRRR-z3w9 Stage K per-record evidence matrix."""

import json
from pathlib import Path
import sys


ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "research"))

from spendability_per_record import (  # noqa: E402
    build_per_record_matrix,
    validate_per_record_matrix,
)


def main() -> int:
    if sys.argv[1:]:
        raise SystemExit("no arguments accepted")
    record = build_per_record_matrix(ROOT)
    validate_per_record_matrix(record, ROOT)
    print(json.dumps(record, indent=2, sort_keys=True, ensure_ascii=True, allow_nan=False))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
